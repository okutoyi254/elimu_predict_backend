              "raw": "{\n  \"records\": [\n    {\n      \"admissionNumber\": \"ADM001\",\n      \"subjectId\": 1,\n      \"marksObtained\": 75.5,\n      \"examType\": \"CAT_1\",\n      \"term\": \"TERM_1\",\n      \"academicYear\": 2024\n    },\n    {\n      \"admissionNumber\": \"ADM002\",\n      \"subjectId\": 1,\n      \"marksObtained\": 60.0,\n      \"examType\": \"CAT_1\",\n      \"term\": \"TERM_1\",\n      \"academicYear\": 2024\n    }\n  ]\n}"
            },
