              "path": ["api", "v1", "users", ":id", "assign-role"],
              "query": [
                {
                  "key": "role",
                  "value": "TEACHER",
                  "description": "One of: TEACHER, SENIOR_TEACHER, ADMIN, PRINCIPAL, DEPUTY_PRINCIPAL, PARENT, IT_HANDLER"
